# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server Port
PORT=5000

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DEV_MODE=v2

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Fast2SMS Configuration
FAST2SMS_API_KEY=your_fast2sms_api_key

# Email / Nodemailer Configuration
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_LOGO_PATH=assets/Ssism_Logo.png
LOGO=assets/Ssism_Logo.png

# Application URLs
FRONTEND_URL=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173/reset-password/

# Environment Mode (development / production)
NODE_ENV=development

# Google OAuth Configuration
GOOGLE_CALLBACK_URL=http://localhost:5000/api/user/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/google-success

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
