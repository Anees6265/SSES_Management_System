VITE_ITEG_ATTENDANCE_STUDENTS_ENDPOINT=/iteg-attendance
VITE_ITEG_ATTENDANCE_API_KEY=your_attendance_api_key

# Auth Endpoint
VITE_LOGIN_WITH_GOOGLE=/user/google
